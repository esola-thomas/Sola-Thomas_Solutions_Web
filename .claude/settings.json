{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/check_site.py)",
      "Bash(python3 -m http.server:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/check_site.py --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
